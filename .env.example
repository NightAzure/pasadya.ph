# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
JOB_SECRET="replace-with-job-secret"

# Phase 02 placeholders
DATABASE_URL="postgresql://user:password@localhost:5432/project_z"
AUTH_SECRET="replace-with-generated-secret"
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"
AUTH_FACEBOOK_ID="replace-with-facebook-client-id"
AUTH_FACEBOOK_SECRET="replace-with-facebook-client-secret"
AUTH_EMAIL_FROM="Pasadya <noreply@pasadya.ph>"

# Later phase placeholders
PAYMONGO_SECRET_KEY="replace-with-paymongo-secret-key"
PAYMONGO_WEBHOOK_SECRET="replace-with-paymongo-webhook-secret"
PAYMONGO_API_URL="https://api.paymongo.com/v1"
R2_ACCOUNT_ID="replace-with-cloudflare-account-id"
R2_ACCESS_KEY_ID="replace-with-r2-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-r2-secret-access-key"
R2_BUCKET_NAME="replace-with-r2-bucket-name"
R2_PUBLIC_BASE_URL="https://cdn.example.test"
R2_ENDPOINT=""
R2_REGION="auto"
RESEND_API_KEY="replace-with-resend-api-key"
SEMAPHORE_API_KEY="replace-with-semaphore-api-key"
# MapTiler's single API key is used for both browser map tiles and server-side
# address search. NEXT_PUBLIC_ makes the browser map request possible; it does
# not mean a second MapTiler credential is required. If this is MapTiler's
# unprotected default key, create a protected replacement only when production
# origin restriction is needed; the application does not require two keys.
# Before beta: restrict the browser key to approved Pasadya origins in MapTiler
# (GAP-048) and keep the free-tier attribution/logo obligation.
NEXT_PUBLIC_MAPTILER_API_KEY="replace-with-maptiler-api-key"
# Optional server-only override for geocoding. Leave unset to use the key above.
MAPTILER_API_KEY=""

# Search 2.0 rollout (Phase 10)
# off = legacy /search rollback; shadow = Search 2.0 + legacy compare; on = Search 2.0
SEARCH_V2_MODE="on"
# Gradual traffic when SEARCH_V2_MODE=on (0-100). Uses opaque cookie bucket only.
SEARCH_V2_ROLLOUT_PERCENT="100"
